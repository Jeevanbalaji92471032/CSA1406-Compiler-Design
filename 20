GRAMMAR:
E → E+T | T
T → T*F | F
F → (E) | id
CODE:
#include <stdio.h>
#include <string.h>

char lhs[] = {'E', 'E', 'T', 'T', 'F', 'F'};
char rhs[][5] = {"E+T", "T", "T*F", "F", "(E)", "i"};

char nt[] = {'E', 'T', 'F'};
char trailing[3][10] = {{0}, {0}, {0}};

int add(int n, char c)
{
    int i;

    for (i = 0; trailing[n][i] != '\0'; i++)
    {
        if (trailing[n][i] == c)
            return 0;
    }

    i = strlen(trailing[n]);
    trailing[n][i] = c;
    trailing[n][i + 1] = '\0';

    return 1;
}

int main()
{
    int i, j, k, change = 1;

    while (change)
    {
        change = 0;

        for (i = 0; i < 6; i++)
        {
            int n = lhs[i] - 'E';

            int len = strlen(rhs[i]);
            char last = rhs[i][len - 1];

            if (last == '+' || last == '*' ||
                last == ')' || last == 'i')
            {
                change |= add(n, last);
            }
            else
            {
                int m = last - 'E';

                if (m >= 0 && m < 3)
                {
                    for (j = 0; trailing[m][j] != '\0'; j++)
                        change |= add(n, trailing[m][j]);
                }

                if (len >= 2)
                {
                    char prev = rhs[i][len - 2];

                    if (prev == '+' || prev == '*' || prev == ')')
                        change |= add(n, prev);
                }
            }
        }
    }

    printf("TRAILING SETS\n\n");

    for (i = 0; i < 3; i++)
    {
        printf("TRAILING(%c) = { ", nt[i]);

        for (j = 0; trailing[i][j] != '\0'; j++)
            printf("%c ", trailing[i][j]);

        printf("}\n");
    }

    return 0;
}


