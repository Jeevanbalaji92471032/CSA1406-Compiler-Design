#include <stdio.h>
#include <string.h>

int main()
{
    char lhs[20], first[20], op[10], operand[20];
    char temp[10];
    int count = 1;

    printf("Enter the expression:\n");
    scanf("%19s = %19s", lhs, first);

    char result[20];
    strcpy(result, first);

    while (scanf("%9s %19s", op, operand) == 2)
    {
        if (strcmp(op, "+") == 0 || strcmp(op, "-") == 0)
        {
            sprintf(temp, "t%d", count);

            printf("%s=%s%s%s\n", temp, result, op, operand);

            strcpy(result, temp);
            count++;
        }
        else
        {
            printf("Invalid operator\n");
            return 0;
        }
    }

    printf("%s=%s\n", lhs, result);

    return 0;
}

INPUT:
out = in1 + in2 + in3 - in4
OUTPUT:
t1=in1+in2
t2=t1+in3
t3=t2-in4
out=t3
